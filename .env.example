# Quotatify — provider API keys
# Copy this file to `.env` and fill in the keys for the providers you use.
# Keys set here take priority over keys saved via the Settings panel.

NUXT_CROF_API_KEY=
NUXT_ZAI_API_KEY=
NUXT_DEEPSEEK_API_KEY=

# Adding a provider? Append the env var you declared as `defaults.envKey` in
# its module (server/providers/<id>.ts), for example:
# NUXT_ACME_API_KEY=
